node_modules/
dist/
build/
.tools/
.env
*.log
# The .sqlite file itself IS committed (see prose-and-thorns.sqlite below) —
# it's the built catalog, and this pilot deploys it as-is rather than
# provisioning a separate persistent database. Only the transient
# journal/WAL/shm files are excluded, since those are regenerated on open.
backend/data/*.sqlite-journal
backend/data/*.sqlite-wal
backend/data/*.sqlite-shm
.DS_Store
backend/data/manual-reviews/
# Working copy of the database (with raw review text) and its backups. Only
# the slim export at backend/data/prose-and-thorns.sqlite is committed --
# see backend/src/db/index.js and `npm run export-slim`.
backend/data/full/
backend/data/backups/
