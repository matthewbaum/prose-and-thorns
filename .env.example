# Copy this file to backend/.env and fill in real values.
# Google Books API key — free, register at https://console.cloud.google.com/ (enable "Books API")
GOOGLE_BOOKS_API_KEY=

# Reddit API credentials — free, register a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=prose-and-thorns/0.1 by <your_reddit_username>

# Anthropic API key
ANTHROPIC_API_KEY=

# Hardcover API token — free, from Account Settings > Hardcover API after signing up at https://hardcover.app
HARDCOVER_API_TOKEN=

# Simple shared-secret gate for the manual pipeline trigger (/api/seed)
ADMIN_PASSWORD=

# Backend server port (frontend dev server proxies /api to this)
PORT=4000
